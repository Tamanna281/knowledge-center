# Example environment variables (DO NOT COMMIT SECRETS)
# Copy this to .env.local (or .env) and fill values locally.

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# App
PORT=3000
JWT_SECRET=replace_with_a_secure_random_value

# Email (optional)
GMAIL_USER=your-email@example.com
GMAIL_PASS=your-email-password

# Twilio (optional)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Google / Gemini API
# Use a single key for your environment. Rotate immediately if exposed.
GOOGLE_API_KEY=AIzaSyC6xpfER9LEaf4IkzFM6_B3nBGXJq1y2I4

