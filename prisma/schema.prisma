// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// === YOUR MODELS ===

// OTP Table - For email and phone verification
model Otp {
  id        String   @id @default(uuid())
  userId    String?
  otp       String
  type      String   // "EMAIL" or "PHONE"
  expiresAt DateTime
  
  createdAt DateTime @default(now())
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  privileges  String[] // Array of privileges e.g. ["VIEW_TREE", "ADD_USER"]
  users       User[]
  
  createdAt   DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  username      String?  @unique  // Optional username
  email         String   @unique
  name          String
  phone         String?
  password      String   
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isActive      Boolean  @default(false)
  
  // Link to Role Table
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])

  // Org context
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Hierarchy - Self-Relation for Manager/Subordinates
  managerId String?
  manager   User?    @relation("UserHierarchy", fields: [managerId], references: [id])
  children  User[]   @relation("UserHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String       @id @default(uuid())
  name        String       @unique
  location    String?
  departments Department[]
  users       User[]
  createdAt   DateTime     @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  users     User[]
  createdAt DateTime @default(now())
  
  @@unique([name, branchId])
}

// ... existing models ...

model Transaction {
  id           Int      @id @default(autoincrement())
  itemName     String   @map("ItemName")
  category     String?  @map("Category")
  quantity     Int      @map("Quantity")
  units        String?  @map("Units")
  price        Float?   @map("Price")
  totalCost    Float?   @map("TotalCost")
  purchaseDate String?  @map("PurchaseDate")
  supplier     String?  @map("Supplier")
  buyer        String?  @map("Buyer")
  createdAt    DateTime @default(now())
}


model KnowledgeBase {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String?
  tags      String
  fileName  String?  @default("Imported File")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
