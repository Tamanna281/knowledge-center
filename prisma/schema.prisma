// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// === YOUR MODELS ===

// OTP Table - For email and phone verification
model Otp {
  id        String   @id @default(uuid())
  userId    String?
  otp       String
  type      String   // "EMAIL" or "PHONE"
  expiresAt DateTime
  
  createdAt DateTime @default(now())
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  privileges  String[] // Array of privileges e.g. ["VIEW_TREE", "ADD_USER"]
  users       User[]
  
  createdAt   DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  username      String?  @unique  // Optional username
  email         String   @unique
  name          String
  phone         String?
  password      String   
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isActive      Boolean  @default(false)
  
  // Link to Role Table
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])


  // Hierarchy - Self-Relation for Manager/Subordinates
  managerId String?
  manager   User?    @relation("UserHierarchy", fields: [managerId], references: [id])
  children  User[]   @relation("UserHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model KnowledgeBase {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String?
  tags      String
  fileName  String?  @default("Imported File")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Chat conversation tracking
model ChatConversation {
  id        String        @id @default(uuid())
  userId    String?       // Optional - can track by user if needed
  title     String?       // Optional conversation title
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// Individual chat messages with full insight support
model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String           // "user" or "bot"
  content        String           @db.Text
  insightData    String?          @db.Text // JSON stringified insight data
  createdAt      DateTime         @default(now())
}

// === NESSCO Product/Machine Data ===
// Flexible schema: Core fields + metadata for dynamic columns
model MachineProduct {
  id              String   @id @default(uuid())
  
  // === CORE IDENTIFICATION FIELDS (Always present) ===
  productCategory String?  // e.g., "PAPER CUP MACHINE", "DIE CUTTING MACHINE"
  productName     String   // e.g., "PCM NS-200 (STANDARD)"
  modelNumber     String   // e.g., "NS-200", "NS-1900"
  productId       String?  // Unique product identifier
  variant         String?  // Model variant
  productStatus   String?  // "ACTIVE", "INACTIVE", "IN PROGRESS", "CLEARANCE"
  
  // === CORE TECHNICAL SPECS (Common queries) ===
  machineSpeed    Float?   // Speed in pieces/min or meter/min
  stableSpeed     Float?   // Stable operating speed
  speedUnit       String?  // "Pcs/Min.", "Meter/Min.", "Bags/Min.", etc.
  weightKg        Float?   // Machine weight in kilograms
  powerKw         Float?   // Power consumption in kilowatts
  
  // === CORE PRICING (For comparisons) ===
  domesticPriceMin   Float?
  domesticPriceMax   Float?
  domesticPriceAvg   Float?
  exportPriceMin     Float?
  exportPriceMax     Float?
  exportPriceAvg     Float?
  currency           String?  // "INR", "USD", etc.
  
  // === CORE ELECTRICAL SPECS (Safety-critical) ===
  operatingVoltage   String?  // "380VAC-400VAC", "220VAC"
  phaseRequirement   String?  // "3P", "1P"
  startingLoadKw     Float?
  runningLoadKw      Float?
  
  // === SIZE/DIMENSIONS ===
  dimensionsP1       String?  // e.g., "2700X1100X1828"
  dimensionsP2       String?
  dimensionsP3       String?
  
  // === FLEXIBLE METADATA (All other columns) ===
  // This stores ALL columns from CSV/PDF as JSON
  // Allows for:
  // 1. New columns without schema changes
  // 2. Variable CSV structures
  // 3. Full data preservation
  metadata           Json?    @db.JsonB
  
  // === SOURCE TRACKING ===
  sourceFile         String   // Original filename
  sourceType         String   // "CSV", "EXCEL", "PDF"
  importedAt         DateTime @default(now())
  
  // === SEARCH OPTIMIZATION ===
  searchText         String?  @db.Text  // Concatenated searchable text
  tags               String[] @default([])
  
  // === TIMESTAMPS ===
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  @@index([productCategory])
  @@index([modelNumber])
  @@index([productStatus])
  @@index([machineSpeed])
  @@index([powerKw])
  @@index([sourceFile])
}
