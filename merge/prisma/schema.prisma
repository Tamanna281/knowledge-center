// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
  // 1. Used for the App (Serverless/Edge friendly)
  // Connects to Supavisor Pooler on Port 6543
  url       = env("DATABASE_URL")
  
  // 2. Used for Migrations (npx prisma migrate)
  // Connects Directly to Postgres on Port 5432
  directUrl = env("DIRECT_URL")
}

// === YOUR MODELS ===

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  privileges  String[] // Array of strings e.g. ["VIEW_TREE", "ADD_USER"]
  
  // Relation to User
  users       User[]
  
  createdAt   DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   
  
  // Link to Role Table
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  
  // Self-Relation for Hierarchy (Manager/Subordinates)
  managerId String?
  manager   User?    @relation("UserHierarchy", fields: [managerId], references: [id])
  children  User[]   @relation("UserHierarchy")

  createdAt DateTime @default(now())
}

model Transaction {
  id           String   @id @default(uuid())
  itemName     String
  category     String
  quantity     Int
  units        String   // e.g. "kg", "pcs"
  price        Float
  totalCost    Float
  purchaseDate DateTime @default(now())
  supplier     String
  buyer        String
  
  createdAt    DateTime @default(now())
}